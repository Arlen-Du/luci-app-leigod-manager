#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# rpcd plugin for luci-app-leigod-manager
# Refactored strictly based on /usr/sbin/leigod official runtime implementation:
#   acc.init, monitor.sh, leigod_uninstall.sh, acc-gw.router.<arch>

SBIN_DIR="/usr/sbin/leigod"
BINARY_PREFIX="acc-gw.router"
FIREWALL_INI="/etc/config/acc_firewall.ini"
VERSION_INI="/etc/config/acc_version.ini"
ACC_LOG="/tmp/leigod_acc_init.log"
MONITOR_SCRIPT="${SBIN_DIR}/monitor.sh"
MONITOR_LOCK="${SBIN_DIR}/acc_daemon.monitor.lock"
MONITOR_LOG="/tmp/leigod_acc_monitor.log"
UNINSTALL_LOG="/tmp/leigod_acc_uninstall.log"

# ---- helpers ----------------------------------------------------------------

_json_bool() {
	[ "$1" = "1" ] || [ "$1" = "true" ] && echo "true" || echo "false"
}

_detect_pkg_mgr() {
	if command -v apk >/dev/null 2>&1; then
		echo "apk"
	elif command -v opkg >/dev/null 2>&1; then
		echo "opkg"
	elif [ -f "/lib/apk/db/installed" ] || [ -d "/lib/apk" ] || [ -d "/usr/lib/apk" ]; then
		echo "apk"
	elif [ -f "/usr/lib/opkg/status" ] || [ -f "/lib/opkg/status" ] || [ -f "/var/lib/opkg/status" ]; then
		echo "opkg"
	else
		echo "none"
	fi
}

_get_installed_pkgs_list() {
	local mgr
	mgr=$(_detect_pkg_mgr)
	if [ "$mgr" = "apk" ]; then
		if [ -f "/lib/apk/db/installed" ]; then
			awk -F: '/^P:/{print $2}' /lib/apk/db/installed 2>/dev/null
			return
		elif [ -f "/usr/lib/apk/db/installed" ]; then
			awk -F: '/^P:/{print $2}' /usr/lib/apk/db/installed 2>/dev/null
			return
		elif command -v apk >/dev/null 2>&1; then
			apk info 2>/dev/null | sed -E 's/-[0-9].*//'
			return
		fi
	fi

	local installed_pkgs=""
	local sf
	for sf in /usr/lib/opkg/status /lib/opkg/status /var/lib/opkg/status; do
		if [ -f "$sf" ]; then
			installed_pkgs=$(awk '/^Package: /{pkg=$2} /^Status: / && /installed/{print pkg}' "$sf" 2>/dev/null)
			[ -n "$installed_pkgs" ] && break
		fi
	done
	if [ -z "$installed_pkgs" ] && command -v opkg >/dev/null 2>&1; then
		installed_pkgs=$(opkg list-installed 2>/dev/null | awk '{print $1}')
	fi
	echo "$installed_pkgs"
}

_is_rom_pkg() {
	local p="$1"
	[ -d /rom ] || return 1

	# 1. APK ROM database
	if [ -f /rom/lib/apk/db/installed ]; then
		case "$p" in
			libpcap1|libpcap)
				grep -qE "^P:(libpcap1|libpcap)$" /rom/lib/apk/db/installed 2>/dev/null && return 0
				;;
			iptables)
				grep -qE "^P:(iptables|iptables-nft|xtables-nft)$" /rom/lib/apk/db/installed 2>/dev/null && return 0
				;;
			kmod-ipt-nat)
				grep -qE "^P:(kmod-ipt-nat|kmod-nft-nat)$" /rom/lib/apk/db/installed 2>/dev/null && return 0
				;;
			kmod-ipt-ipset)
				grep -qE "^P:(kmod-ipt-ipset|kmod-nft-ipset)$" /rom/lib/apk/db/installed 2>/dev/null && return 0
				;;
			kmod-ipt-tproxy)
				grep -qE "^P:(kmod-ipt-tproxy|kmod-nft-tproxy)$" /rom/lib/apk/db/installed 2>/dev/null && return 0
				;;
			*)
				grep -qx "P:${p}" /rom/lib/apk/db/installed 2>/dev/null && return 0
				;;
		esac
	fi

	# 2. OPKG ROM control files
	local base
	for base in /rom/usr/lib/opkg/info /rom/lib/opkg/info /rom/var/lib/opkg/info; do
		[ -d "$base" ] || continue
		case "$p" in
			libpcap1|libpcap)
				[ -f "${base}/libpcap1.control" ] || [ -f "${base}/libpcap.control" ] && return 0
				;;
			iptables)
				[ -f "${base}/iptables.control" ] || [ -f "${base}/iptables-nft.control" ] || [ -f "${base}/xtables-nft.control" ] && return 0
				;;
			kmod-ipt-nat)
				[ -f "${base}/kmod-ipt-nat.control" ] || [ -f "${base}/kmod-nft-nat.control" ] && return 0
				;;
			kmod-ipt-ipset)
				[ -f "${base}/kmod-ipt-ipset.control" ] || [ -f "${base}/kmod-nft-ipset.control" ] && return 0
				;;
			kmod-ipt-tproxy)
				[ -f "${base}/kmod-ipt-tproxy.control" ] || [ -f "${base}/kmod-nft-tproxy.control" ] && return 0
				;;
			*)
				[ -f "${base}/${p}.control" ] && return 0
				;;
		esac
	done

	# 3. Fallback checks in /rom binaries
	case "$p" in
		iptables) [ -x /rom/usr/sbin/iptables ] || [ -x /rom/sbin/iptables ] && return 0 ;;
		ipset)    [ -x /rom/usr/sbin/ipset ] || [ -x /rom/sbin/ipset ] && return 0 ;;
		curl)     [ -x /rom/usr/bin/curl ] || [ -x /rom/bin/curl ] && return 0 ;;
	esac
	return 1
}

_is_installed_pkg() {
	local p="$1"
	local installed_pkgs="$2"
	[ -z "$installed_pkgs" ] && installed_pkgs=$(_get_installed_pkgs_list)
	local mgr
	mgr=$(_detect_pkg_mgr)

	# 1. APK package manager check
	if [ "$mgr" = "apk" ]; then
		if [ -n "$installed_pkgs" ]; then
			case "$p" in
				libpcap1|libpcap)
					echo "$installed_pkgs" | grep -qE "^(libpcap1|libpcap)$" 2>/dev/null && return 0
					;;
				iptables)
					echo "$installed_pkgs" | grep -qE "^(iptables|iptables-nft|iptables-legacy|xtables-nft)$" 2>/dev/null && return 0
					;;
				kmod-tun)
					echo "$installed_pkgs" | grep -qx "kmod-tun" 2>/dev/null && return 0
					;;
				ipset)
					echo "$installed_pkgs" | grep -qx "ipset" 2>/dev/null && return 0
					;;
				curl)
					echo "$installed_pkgs" | grep -qx "curl" 2>/dev/null && return 0
					;;
				kmod-ipt-nat)
					echo "$installed_pkgs" | grep -qE "^(kmod-ipt-nat|kmod-nft-nat)$" 2>/dev/null && return 0
					;;
				kmod-ipt-ipset)
					echo "$installed_pkgs" | grep -qE "^(kmod-ipt-ipset|kmod-nft-ipset)$" 2>/dev/null && return 0
					;;
				kmod-ipt-tproxy)
					echo "$installed_pkgs" | grep -qE "^(kmod-ipt-tproxy|kmod-nft-tproxy)$" 2>/dev/null && return 0
					;;
				iptables-mod-tproxy)
					echo "$installed_pkgs" | grep -qx "iptables-mod-tproxy" 2>/dev/null && return 0
					;;
				*)
					echo "$installed_pkgs" | grep -qx "$p" 2>/dev/null && return 0
					;;
			esac
		fi
		if command -v apk >/dev/null 2>&1; then
			case "$p" in
				libpcap1|libpcap)
					apk info -e libpcap >/dev/null 2>&1 || apk info -e libpcap1 >/dev/null 2>&1 && return 0
					;;
				iptables)
					apk info -e iptables >/dev/null 2>&1 || apk info -e iptables-nft >/dev/null 2>&1 || apk info -e xtables-nft >/dev/null 2>&1 && return 0
					;;
				kmod-ipt-nat)
					apk info -e kmod-ipt-nat >/dev/null 2>&1 || apk info -e kmod-nft-nat >/dev/null 2>&1 && return 0
					;;
				kmod-ipt-ipset)
					apk info -e kmod-ipt-ipset >/dev/null 2>&1 || apk info -e kmod-nft-ipset >/dev/null 2>&1 && return 0
					;;
				kmod-ipt-tproxy)
					apk info -e kmod-ipt-tproxy >/dev/null 2>&1 || apk info -e kmod-nft-tproxy >/dev/null 2>&1 && return 0
					;;
				*)
					apk info -e "$p" >/dev/null 2>&1 && return 0
					;;
			esac
		fi
		# Check if component is in read-only ROM
		_is_rom_pkg "$p" && return 0
		return 1
	fi

	# 2. OPKG package manager check
	if [ "$mgr" = "opkg" ]; then
		if [ -n "$installed_pkgs" ]; then
			case "$p" in
				libpcap1|libpcap)
					echo "$installed_pkgs" | grep -qE "^(libpcap1|libpcap)$" 2>/dev/null && return 0
					[ -f /usr/lib/opkg/info/libpcap1.control ] || [ -f /usr/lib/opkg/info/libpcap.control ] || [ -f /lib/opkg/info/libpcap1.control ] && return 0
					;;
				iptables)
					echo "$installed_pkgs" | grep -qE "^(iptables|iptables-nft|iptables-legacy|xtables-nft)$" 2>/dev/null && return 0
					[ -f /usr/lib/opkg/info/iptables.control ] || [ -f /usr/lib/opkg/info/iptables-nft.control ] || [ -f /usr/lib/opkg/info/xtables-nft.control ] && return 0
					;;
				kmod-tun)
					echo "$installed_pkgs" | grep -qx "kmod-tun" 2>/dev/null && return 0
					[ -f /usr/lib/opkg/info/kmod-tun.control ] || [ -f /lib/opkg/info/kmod-tun.control ] && return 0
					;;
				ipset)
					echo "$installed_pkgs" | grep -qx "ipset" 2>/dev/null && return 0
					[ -f /usr/lib/opkg/info/ipset.control ] && return 0
					;;
				curl)
					echo "$installed_pkgs" | grep -qx "curl" 2>/dev/null && return 0
					[ -f /usr/lib/opkg/info/curl.control ] && return 0
					;;
				kmod-ipt-nat)
					echo "$installed_pkgs" | grep -qE "^(kmod-ipt-nat|kmod-nft-nat)$" 2>/dev/null && return 0
					[ -f /usr/lib/opkg/info/kmod-ipt-nat.control ] || [ -f /usr/lib/opkg/info/kmod-nft-nat.control ] && return 0
					;;
				kmod-ipt-ipset)
					echo "$installed_pkgs" | grep -qE "^(kmod-ipt-ipset|kmod-nft-ipset)$" 2>/dev/null && return 0
					[ -f /usr/lib/opkg/info/kmod-ipt-ipset.control ] || [ -f /usr/lib/opkg/info/kmod-nft-ipset.control ] && return 0
					;;
				kmod-ipt-tproxy)
					echo "$installed_pkgs" | grep -qE "^(kmod-ipt-tproxy|kmod-nft-tproxy)$" 2>/dev/null && return 0
					[ -f /usr/lib/opkg/info/kmod-ipt-tproxy.control ] || [ -f /usr/lib/opkg/info/kmod-nft-tproxy.control ] && return 0
					;;
				iptables-mod-tproxy)
					echo "$installed_pkgs" | grep -qx "iptables-mod-tproxy" 2>/dev/null && return 0
					[ -f /usr/lib/opkg/info/iptables-mod-tproxy.control ] && return 0
					;;
				*)
					echo "$installed_pkgs" | grep -qx "$p" 2>/dev/null && return 0
					[ -f "/usr/lib/opkg/info/${p}.control" ] || [ -f "/lib/opkg/info/${p}.control" ] && return 0
					;;
			esac
		fi
		# Check if component is in read-only ROM
		_is_rom_pkg "$p" && return 0
		return 1
	fi

	# 3. Fallback check ONLY when NO package manager is available (mgr == "none")
	case "$p" in
		libpcap1|libpcap)
			ls -d /usr/lib/libpcap* /lib/libpcap* /usr/lib64/libpcap* /lib64/libpcap* 2>/dev/null | grep -q . && return 0
			[ -e /usr/lib/libpcap.so ] || [ -e /usr/lib/libpcap.so.1 ] || [ -e /lib/libpcap.so ] || [ -e /lib/libpcap.so.1 ] && return 0
			;;
		iptables)
			[ -x /usr/sbin/iptables ] || [ -x /sbin/iptables ] || [ -x /usr/bin/iptables ] && return 0
			iptables -V >/dev/null 2>&1 && return 0
			;;
		ipset)
			[ -x /usr/sbin/ipset ] || [ -x /sbin/ipset ] || [ -x /usr/bin/ipset ] && return 0
			;;
		curl)
			[ -x /usr/bin/curl ] || [ -x /bin/curl ] && return 0
			;;
		kmod-tun)
			[ -e /dev/net/tun ] || lsmod 2>/dev/null | grep -q "^tun " && return 0
			;;
		iptables-mod-tproxy)
			# Only check legacy iptables path; /usr/lib/xtables/libxt_TPROXY.so is part of iptables-nft, NOT iptables-mod-tproxy!
			[ -f /usr/lib/iptables/libxt_TPROXY.so ] && return 0
			;;
	esac
	return 1
}

_check_missing_deps() {
	local mode="$1"
	local installed_pkgs="$2"
	[ -z "$installed_pkgs" ] && installed_pkgs=$(_get_installed_pkgs_list)
	local pkgs="" missing=""
	if [ "$mode" = "tun" ]; then
		pkgs="libpcap1 iptables kmod-tun kmod-ipt-nat kmod-ipt-ipset ipset curl"
	elif [ "$mode" = "tproxy" ]; then
		pkgs="libpcap1 iptables iptables-mod-tproxy kmod-ipt-tproxy kmod-ipt-nat kmod-ipt-ipset ipset curl"
	fi
	for p in $pkgs; do
		# In fw4 / nftables systems, iptables-nft already includes libxt_TPROXY.so, so iptables-mod-tproxy is not required as a standalone package
		if [ "$p" = "iptables-mod-tproxy" ] && [ -f /usr/lib/xtables/libxt_TPROXY.so ]; then
			continue
		fi
		if ! _is_installed_pkg "$p" "$installed_pkgs"; then
			[ -n "$missing" ] && missing="${missing}, "
			missing="${missing}${p}"
		fi
	done
	echo "$missing"
}

get_arch() {
	local raw
	raw=$(uname -m 2>/dev/null)
	case "${raw}" in
		x86_64) echo "amd64" ;;
		aarch64|aarch64_be) echo "arm64" ;;
		mips|mips64) echo "mipsel" ;;
		armv7l|armv7hl|armv6l|armv5tel) echo "arm" ;;
		*) echo "${raw}" ;;
	esac
}

# Find all PIDs whose /proc/<pid>/cmdline contains pattern
_find_pids_by_cmdline() {
	local pattern="$1" p cmdline
	for p in /proc/[0-9]*; do
		[ -r "${p}/cmdline" ] || continue
		cmdline=$(tr '\0' ' ' < "${p}/cmdline" 2>/dev/null) || continue
		case "${cmdline}" in
			*"${pattern}"*) basename "${p}" ;;
		esac
	done
}

# Find daemon PID (distinguishes -r daemon from -r web)
_get_daemon_pid() {
	local arch p cmdline
	arch=$(get_arch)
	for p in /proc/[0-9]*; do
		[ -r "${p}/cmdline" ] || continue
		cmdline=$(tr '\0' ' ' < "${p}/cmdline" 2>/dev/null) || continue
		case "${cmdline}" in
			*"${BINARY_PREFIX}.${arch}"*"-r daemon"*|*"${BINARY_PREFIX}"*"-r daemon"*|*"leigod-acc"*)
				basename "${p}"
				return 0
				;;
		esac
	done
	return 1
}

# Check if monitor.sh watchdog is running
_is_monitor_running() {
	local p
	for p in $(_find_pids_by_cmdline "monitor.sh"); do
		return 0
	done
	return 1
}

# Terminate monitor.sh watchdog
_stop_monitor() {
	local p
	for p in $(_find_pids_by_cmdline "monitor.sh"); do
		kill -9 "$p" >/dev/null 2>&1 || true
	done
	rm -f "$MONITOR_LOCK" 2>/dev/null || true
}

# Launch monitor.sh watchdog (official /usr/sbin/leigod/monitor.sh)
_start_monitor() {
	[ -f "$MONITOR_SCRIPT" ] || return 1
	chmod 0755 "$MONITOR_SCRIPT" 2>/dev/null || true

	# Disable legacy procd acc init if present to prevent conflict
	if [ -f "/etc/init.d/acc" ]; then
		/etc/init.d/acc stop >/dev/null 2>&1 || true
		/etc/init.d/acc disable >/dev/null 2>&1 || true
	fi

	# Stop any stale monitor instance and clear lock
	_stop_monitor

	if command -v nohup >/dev/null 2>&1; then
		nohup sh "$MONITOR_SCRIPT" >> "$MONITOR_LOG" 2>&1 &
	else
		sh "$MONITOR_SCRIPT" >> "$MONITOR_LOG" 2>&1 &
	fi
	return 0
}


_is_installed() {
	local arch
	arch=$(get_arch)
	[ -x "${SBIN_DIR}/${BINARY_PREFIX}.${arch}" ] || \
	[ -x "/usr/sbin/leigod-acc" ]
}

_is_running() {
	local pid
	pid=$(_get_daemon_pid)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		return 0
	fi
	return 1
}

_detect_fw() {
	if command -v nft >/dev/null 2>&1 && nft list ruleset >/dev/null 2>&1; then
		echo "fw4"
	else
		echo "fw3"
	fi
}

_tproxy_compat() {
	local fw
	fw=$(_detect_fw)
	if [ "$fw" = "fw4" ]; then
		if iptables-legacy -t mangle -L >/dev/null 2>&1; then
			echo "iptables-legacy"
		else
			echo "none"
		fi
	else
		echo "iptables"
	fi
}

_read_ini_field() {
	local field="$1" file="${2:-$FIREWALL_INI}"
	[ -f "${file}" ] || return 1
	grep "^${field}=" "${file}" 2>/dev/null | head -1 | cut -d'=' -f2- | tr -d '\r\n"'
}

# Clean accelerator firewall rules (aligned with acc.init and leigod_uninstall.sh)
_clean_rules() {
	local chain="GAMEACC" tbl built name
	# iptables: mangle / filter / nat
	for tbl in mangle filter nat; do
		case "${tbl}" in filter) built="INPUT" ;; *) built="PREROUTING" ;; esac
		iptables -t ${tbl} -D ${built} -j ${chain} 2>/dev/null || true
		iptables -t ${tbl} -F ${chain} 2>/dev/null || true
		iptables -t ${tbl} -X ${chain} 2>/dev/null || true
	done
	# nftables: inet tproxy_table
	nft delete table inet tproxy_table 2>/dev/null || true
	# ipset: direct_* / target_* / proxy_*
	for name in $(ipset list -n 2>/dev/null); do
		case "${name}" in
			direct_*|target_*|proxy_*) ipset destroy "${name}" 2>/dev/null || true ;;
		esac
	done
	# Remove any dangling tun interfaces
	local dev
	for dev in $(ip link show 2>/dev/null | grep -o 'tun_[a-zA-Z0-9_-]*' | sort -u); do
		ip link set "$dev" down 2>/dev/null || true
		ip tuntap del mode tun dev "$dev" 2>/dev/null || true
	done
}

# Graceful termination then SIGKILL (aligned with leigod_uninstall.sh)
_kill_acc() {
	local arch pat p
	arch=$(get_arch)
	# 1. SIGUSR1 graceful session close
	for pat in "${BINARY_PREFIX}.${arch}" "${BINARY_PREFIX}" "acc_upgrade_monitor" "monitor.sh" "leigod-acc"; do
		for p in $(_find_pids_by_cmdline "${pat}"); do
			kill -USR1 "${p}" >/dev/null 2>&1 || true
		done
	done
	sleep 1
	# 2. SIGKILL fallback
	for pat in "${BINARY_PREFIX}.${arch}" "${BINARY_PREFIX}" "acc_upgrade_monitor" "monitor.sh" "leigod-acc"; do
		for p in $(_find_pids_by_cmdline "${pat}"); do
			kill -9 "${p}" >/dev/null 2>&1 || true
		done
	done
}

# Ensure kernel modules and /dev/net/tun exist (aligned with acc.init and monitor.sh)
_ensure_modules_loaded() {
	local mode="${1:-tproxy}" modules m
	if [ "${mode}" = "tproxy" ]; then
		modules="xt_TPROXY nf_tproxy_core xt_set ip_set ip_set_hash_net ip_set_list_set"
	else
		# TUN mode in acc-gw.router strictly requires:
		# - tun (for /dev/net/tun)
		# - ip_set, xt_set (for create_tun_ipset: target_<dev> and direct_<dev>)
		# - iptables mangle/nat/filter/mark (for create_tun_iptables)
		modules="tun xt_set ip_set ip_set_hash_net ip_set_list_set iptable_mangle iptable_nat iptable_filter xt_mark"
		[ -d /dev/net ] || mkdir -p /dev/net 2>/dev/null
		[ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200 2>/dev/null || true
		chmod 0666 /dev/net/tun 2>/dev/null || true
	fi

	for m in ${modules}; do
		if ! lsmod 2>/dev/null | grep -q "^${m} "; then
			modprobe "${m}" >/dev/null 2>&1 || true
		fi
	done
}

# TUN environment verification and automatic preparation
_prepare_tun_env() {
	# 1. Install dependencies specified for tun mode:
	# libpcap1/libpcap, kmod-tun, kmod-ipt-nat/kmod-nft-nat, kmod-ipt-ipset/kmod-nft-ipset, ipset, curl
	local mgr
	mgr=$(_detect_pkg_mgr)
	if [ "$mgr" = "opkg" ]; then
		opkg install libpcap1 kmod-tun kmod-ipt-nat kmod-ipt-ipset ipset curl ip-full >/dev/null 2>&1 || \
		opkg install libpcap kmod-tun kmod-nft-nat kmod-nft-ipset ipset curl ip-full >/dev/null 2>&1 || true
	elif [ "$mgr" = "apk" ]; then
		apk add libpcap kmod-tun ipset curl ip-full >/dev/null 2>&1 || true
		apk add kmod-ipt-nat >/dev/null 2>&1 || apk add kmod-nft-nat >/dev/null 2>&1 || true
		apk add kmod-ipt-ipset >/dev/null 2>&1 || apk add kmod-nft-ipset >/dev/null 2>&1 || true
	fi

	# 2. Ensure /dev/net/tun exists with proper permissions
	[ -d /dev/net ] || mkdir -p /dev/net 2>/dev/null
	if [ ! -c /dev/net/tun ]; then
		mknod /dev/net/tun c 10 200 2>/dev/null || true
		chmod 0666 /dev/net/tun 2>/dev/null || true
	fi

	# 3. Load all required kernel modules for TUN mode
	_ensure_modules_loaded "tun"

	return 0
}

# Extract latest error message from daemon or log files
_get_last_error() {
	local err=""
	if [ -f "${SBIN_DIR}/acc_daemon.out" ]; then
		err=$(tail -n 15 "${SBIN_DIR}/acc_daemon.out" 2>/dev/null | grep -iE "fail|error|fatal|unsupport|cannot|abort" | tail -1)
	fi
	if [ -z "$err" ]; then
		local f
		for f in /tmp/acc/*.log; do
			[ -f "$f" ] || continue
			err=$(tail -n 15 "$f" 2>/dev/null | grep -iE "failed|error|fatal|unsupport" | tail -1)
			[ -n "$err" ] && break
		done
	fi
	if [ -z "$err" ] && [ -f "$ACC_LOG" ]; then
		err=$(tail -n 10 "$ACC_LOG" 2>/dev/null | grep -iE "fail|error" | tail -1)
	fi
	if [ -z "$err" ]; then
		err=$(logread 2>/dev/null | grep -iE "acc-gw|leigod" | grep -iE "failed|error|exit" | tail -1)
	fi
	[ -n "$err" ] && echo "$err" | tr '\r\n"' ' ' | sed 's/^[ \t]*//;s/[ \t]*$//'
}

# Ensure /etc/init.d/acc exists and is executable
_ensure_init_script() {
	if [ ! -f "/etc/init.d/acc" ] && [ -f "${SBIN_DIR}/acc.init" ]; then
		cp -f "${SBIN_DIR}/acc.init" "/etc/init.d/acc"
		chmod 0755 "/etc/init.d/acc"
	fi
	if [ -f "/etc/init.d/acc" ]; then
		chmod 0755 "/etc/init.d/acc" 2>/dev/null || true
		# Repair any previous corrupted substitutions (--mode tun -> ${args})
		sed -i 's|--mode tun|\${args}|g' /etc/init.d/acc 2>/dev/null || true
		echo "/etc/init.d/acc"
	elif [ -f "/etc/init.d/leigod" ]; then
		chmod 0755 "/etc/init.d/leigod" 2>/dev/null || true
		echo "/etc/init.d/leigod"
	elif [ -f "/etc/init.d/leigod-acc" ]; then
		chmod 0755 "/etc/init.d/leigod-acc" 2>/dev/null || true
		echo "/etc/init.d/leigod-acc"
	fi
}

_get_mode() {
	# 1. Check running process cmdline
	local pid
	pid=$(_get_daemon_pid)
	if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ]; then
		local cmd
		cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
		case "$cmd" in
			*"-m tun "*|*"--mode tun "*|*"-m tun"|*"--mode tun")
				echo "tun"
				return
				;;
			*"-m tproxy "*|*"--mode tproxy "*|*"-m tproxy"|*"--mode tproxy")
				echo "tproxy"
				return
				;;
		esac
	fi

	# 2. Check /etc/config/acc_firewall.ini
	local ini_mode
	ini_mode=$(_read_ini_field mode "$FIREWALL_INI")
	[ "$ini_mode" = "tun" ] && { echo "tun"; return; }
	[ "$ini_mode" = "tproxy" ] && { echo "tproxy"; return; }

	# 3. Check UCI accelerator.base.tun (Lean IPKG version)
	local tun
	tun=$(uci get accelerator.base.tun 2>/dev/null)
	if [ "$tun" = "1" ]; then
		echo "tun"
		return
	elif [ "$tun" = "0" ]; then
		echo "tproxy"
		return
	fi

	# 4. Check /etc/init.d/acc for legacy --mode tun
	if [ -f "/etc/init.d/acc" ] && grep -q -- "--mode tun" /etc/init.d/acc 2>/dev/null; then
		echo "tun"
		return
	fi

	# 5. Check leigod-manager UCI
	local lm
	lm=$(uci get leigod-manager.base.mode 2>/dev/null)
	[ "$lm" = "tun" ] && { echo "tun"; return; }

	echo "tproxy"
}

_apply_mode() {
	local mode="$1"
	[ -z "$mode" ] && return

	# 1. Update /etc/config/acc_firewall.ini
	# CRITICAL NOTE: In acc-gw.router, TUN mode ONLY supports backend=iptables!
	# Setting backend=nftables in TUN mode causes add_direct_target to call
	# NftableMgr on non-existent tproxy_table, aborting with 'add acc device failed.'
	local fw backend tproxy_ip
	fw=$(_detect_fw)
	tproxy_ip="10.20.30.40"
	if [ "$mode" = "tun" ]; then
		backend="iptables"
	else
		[ "$fw" = "fw4" ] && backend="nftables" || backend="iptables"
	fi

	if [ -f "$FIREWALL_INI" ]; then
		if grep -q "^mode=" "$FIREWALL_INI" 2>/dev/null; then
			sed -i "s/^mode=.*/mode=${mode}/" "$FIREWALL_INI"
		else
			echo "mode=${mode}" >> "$FIREWALL_INI"
		fi
		if grep -q "^backend=" "$FIREWALL_INI" 2>/dev/null; then
			sed -i "s/^backend=.*/backend=${backend}/" "$FIREWALL_INI"
		else
			echo "backend=${backend}" >> "$FIREWALL_INI"
		fi
		if grep -q "^tproxy_ip=" "$FIREWALL_INI" 2>/dev/null; then
			sed -i "s/^tproxy_ip=.*/tproxy_ip=${tproxy_ip}/" "$FIREWALL_INI"
		else
			echo "tproxy_ip=${tproxy_ip}" >> "$FIREWALL_INI"
		fi
	else
		mkdir -p "$(dirname "$FIREWALL_INI")"
		cat > "$FIREWALL_INI" <<EOF
[firewall]
backend=${backend}
mode=${mode}
tproxy_ip=${tproxy_ip}
EOF
	fi

	# 2. Update UCI accelerator (Lean IPKG)
	if uci get accelerator.base >/dev/null 2>&1; then
		[ "$mode" = "tun" ] && uci set accelerator.base.tun='1' || uci set accelerator.base.tun='0'
		uci commit accelerator 2>/dev/null || true
	fi

	# 3. Update UCI leigod-manager
	uci set leigod-manager.base.mode="$mode"
	uci commit leigod-manager 2>/dev/null || true

	# 4. Update init scripts according to mode (step 2)
	_ensure_init_script >/dev/null 2>&1
	if [ "$mode" = "tun" ]; then
		[ -f /etc/init.d/acc ] && sed -i '/10.20.30.40/ s/tproxy/tun/' /etc/init.d/acc 2>/dev/null || true
		[ -f "${SBIN_DIR}/monitor.sh" ] && sed -i '/10.20.30.40/ s/tproxy/tun/' "${SBIN_DIR}/monitor.sh" 2>/dev/null || true
	else
		[ -f /etc/init.d/acc ] && sed -i '/10.20.30.40/ s/tun/tproxy/' /etc/init.d/acc 2>/dev/null || true
		[ -f "${SBIN_DIR}/monitor.sh" ] && sed -i '/10.20.30.40/ s/tun/tproxy/' "${SBIN_DIR}/monitor.sh" 2>/dev/null || true
	fi

	# 5. Load modules and verify device
	if [ "$mode" = "tun" ]; then
		_prepare_tun_env >/dev/null 2>&1 || true
	else
		_ensure_modules_loaded "$mode"
	fi
}

_get_version() {
	local ver=""
	ver=$(_read_ini_field version "$VERSION_INI")
	if [ -z "$ver" ] && [ -f "${SBIN_DIR}/version" ]; then
		ver=$(cat "${SBIN_DIR}/version" 2>/dev/null | tr -d ' \r\n')
	fi
	if [ -z "$ver" ]; then
		local arch bin
		arch=$(get_arch)
		bin="${SBIN_DIR}/${BINARY_PREFIX}.${arch}"
		if [ -x "$bin" ]; then
			ver=$("$bin" -v 2>/dev/null | awk '{print $NF}' | head -n1)
		fi
	fi
	if [ -z "$ver" ]; then
		if command -v opkg >/dev/null 2>&1; then
			ver=$(opkg info leigod-acc 2>/dev/null | awk '/^Version:/{print $2; exit}')
		fi
		if [ -z "$ver" ] && command -v apk >/dev/null 2>&1; then
			ver=$(apk info leigod-acc 2>/dev/null | awk -F'-' '{print $(NF-1)"-"$NF; exit}')
		fi
	fi
	[ -n "$ver" ] && echo "$ver" || echo "running"
}

# ---- RPC methods ------------------------------------------------------------

do_get_status() {
	local installed running monitor_running mode version fw tproxy_compat uptime_str pkg_mgr
	_is_installed && installed="true" || installed="false"
	_is_running   && running="true"   || running="false"
	_is_monitor_running && monitor_running="true" || monitor_running="false"
	mode=$(_get_mode)
	version=$(_get_version)
	fw=$(_detect_fw)
	tproxy_compat=$(_tproxy_compat)
	pkg_mgr=$(_detect_pkg_mgr)

	uptime_str=""
	if _is_running; then
		local pid start_time
		pid=$(_get_daemon_pid)
		if [ -n "$pid" ]; then
			start_time=$(cat /proc/"$pid"/stat 2>/dev/null | awk '{print $22}')
			if [ -n "$start_time" ]; then
				local hz sys_uptime elapsed h m s
				hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
				sys_uptime=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
				elapsed=$((sys_uptime - start_time / hz))
				[ "$elapsed" -lt 0 ] && elapsed=0
				h=$((elapsed / 3600))
				m=$(((elapsed % 3600) / 60))
				s=$((elapsed % 60))
				uptime_str=$(printf "%02d:%02d:%02d" "$h" "$m" "$s")
			fi
		fi
	fi

	printf '{"installed":%s,"running":%s,"monitor_running":%s,"mode":"%s","version":"%s","fw":"%s","tproxy_compat":"%s","uptime":"%s","pkg_mgr":"%s"}\n' \
		"$installed" "$running" "$monitor_running" "$mode" "$version" "$fw" "$tproxy_compat" "$uptime_str" "$pkg_mgr"
}

do_start() {
	local mode
	mode=$(_get_mode)

	if [ "$mode" = "tun" ]; then
		_prepare_tun_env >/dev/null 2>&1
	else
		_ensure_modules_loaded "$mode"
	fi

	# Always ensure acc_firewall.ini and init scripts have correct mode before starting
	_apply_mode "$mode"

	# Start acceleration service
	if [ -f /etc/init.d/acc ]; then
		chmod 0755 /etc/init.d/acc 2>/dev/null || true
		/etc/init.d/acc enable 2>/dev/null || true
		/etc/init.d/acc start >/dev/null 2>&1 || true
	elif [ -f /etc/init.d/leigod-acc ]; then
		/etc/init.d/leigod-acc start >/dev/null 2>&1 || true
	fi

	# Ensure monitor.sh is also supervising
	_start_monitor

	# Fast-poll up to 6 seconds (checking every 500ms) until daemon is confirmed running
	local waited=0
	while [ "$waited" -lt 12 ]; do
		_is_running && break
		sleep 0.5 2>/dev/null || sleep 1
		waited=$((waited + 1))
	done

	if _is_running; then
		printf '{"code":0,"message":"started"}\n'
	else
		local err
		err=$(_get_last_error)
		[ -z "$err" ] && err="服务启动超时或失败"
		printf '{"code":1,"message":"%s"}\n' "$err"
	fi
}

do_stop() {
	# 1. Stop /etc/init.d/acc
	[ -f "/etc/init.d/acc" ] && /etc/init.d/acc stop >/dev/null 2>&1 || true

	# 2. Stop monitor supervisor first so it does not resurrect killed processes
	_stop_monitor

	# 3. Kill acc processes
	_kill_acc
	ps 2>/dev/null | grep acc | grep -v grep | awk '{print $1}' | xargs -r kill -9 2>/dev/null || true

	# 4. Clean rules
	_clean_rules

	sleep 1
	_is_running && printf '{"code":1,"message":"failed to stop"}\n' || printf '{"code":0,"message":"stopped"}\n'
}

do_restart() {
	do_stop >/dev/null 2>&1
	sleep 1
	do_start
}

do_set_mode() {
	local input mode
	input=$(cat)
	mode=$(echo "$input" | jsonfilter -e '@.mode' 2>/dev/null)

	# Toggle if mode is empty or "switch"
	if [ -z "$mode" ] || [ "$mode" = "switch" ]; then
		local cur
		cur=$(_get_mode)
		[ "$cur" = "tun" ] && mode="tproxy" || mode="tun"
	fi

	case "$mode" in
		tun|tproxy)
			# 0. 检查目标模式依赖是否完整
			local missing_deps
			missing_deps=$(_check_missing_deps "$mode")
			if [ -n "$missing_deps" ]; then
				printf '{"code":1,"message":"%s 模式依赖未完成安装 (缺少: %s)，请先安装依赖"}\n' "$mode" "$missing_deps"
				return
			fi

			# 1. 关闭雷神加速服务
			[ -f /etc/init.d/acc ] && /etc/init.d/acc stop >/dev/null 2>&1 || true
			_stop_monitor
			_kill_acc
			ps 2>/dev/null | grep acc | grep -v grep | awk '{print $1}' | xargs -r kill -9 2>/dev/null || true
			_clean_rules

			# 2. 执行命令把启动脚本与配置模式修改
			_apply_mode "$mode"

			# 3. 安装依赖包（tun 模式）
			if [ "$mode" = "tun" ]; then
				_prepare_tun_env >/dev/null 2>&1
			fi

			# 4. 启动雷神加速服务
			if [ -f /etc/init.d/acc ]; then
				chmod 0755 /etc/init.d/acc 2>/dev/null || true
				/etc/init.d/acc enable 2>/dev/null || true
				/etc/init.d/acc start >/dev/null 2>&1 || true
			elif [ -f /etc/init.d/leigod-acc ]; then
				/etc/init.d/leigod-acc start >/dev/null 2>&1 || true
			fi
			_start_monitor

			# 5. 查看进程起来没
			local waited=0
			while [ "$waited" -lt 12 ]; do
				_is_running && break
				sleep 0.5 2>/dev/null || sleep 1
				waited=$((waited + 1))
			done

			if _is_running; then
				printf '{"code":0,"message":"mode set to %s"}\n' "$mode"
			else
				local last_err
				last_err=$(_get_last_error)
				[ -z "$last_err" ] && last_err="${mode} 模式启动超时或失败"
				printf '{"code":1,"message":"%s"}\n' "$last_err"
			fi
			;;
		*)
			printf '{"code":1,"message":"invalid mode, use tun or tproxy"}\n'
			;;
	esac
}

do_get_logs() {
	local input lines
	input=$(cat)
	lines=$(echo "$input" | jsonfilter -e '@.lines' 2>/dev/null)
	[ -z "$lines" ] || [ "$lines" -le 0 ] 2>/dev/null && lines=100

	local log_content=""
	local candidate
	# Priority list of log sources
	for candidate in \
		"${ACC_LOG}" \
		"${MONITOR_LOG}" \
		"${SBIN_DIR}/acc_daemon.out" \
		"${SBIN_DIR}/acc_upgrade_monitor.out" \
		"${UNINSTALL_LOG}" \
		/tmp/acc/*.log; do
		if [ -f "$candidate" ] && [ -s "$candidate" ]; then
			log_content=$(tail -n "$lines" "$candidate" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' -e 's/$/\\n/g' | tr -d '\n')
			break
		fi
	done

	[ -z "$log_content" ] && log_content="(暂未在 /tmp 或 /usr/sbin/leigod 检测到活跃的服务日志)"

	# 系统日志 (Syslog / dmesg) 综合采集
	local sys_raw=""
	# 1. 首选 logread
	if command -v logread >/dev/null 2>&1; then
		sys_raw=$(logread 2>/dev/null)
	fi

	# 2. 若 logread 无输出，尝试系统日志文件
	if [ -z "$sys_raw" ]; then
		for f in /var/log/messages /tmp/messages /var/log/syslog; do
			if [ -f "$f" ] && [ -s "$f" ]; then
				sys_raw=$(cat "$f" 2>/dev/null)
				break
			fi
		done
	fi

	local sys_filtered=""
	# 匹配 leigod-acc 服务、acc 守护进程、网卡事件及防火墙规则
	if [ -n "$sys_raw" ]; then
		sys_filtered=$(echo "$sys_raw" | grep -iE "leigod|acc[-_.:/ ]|GAMEACC|tproxy_table|acc-gw|\bacc\b" | tail -n "$lines")
	fi

	# 3. 若 syslog 暂未记录到关键词，尝试读取内核 dmesg 关联信息
	if [ -z "$sys_filtered" ]; then
		local dmesg_match=""
		dmesg_match=$(dmesg 2>/dev/null | grep -iE "leigod|acc[-_.:/ ]|GAMEACC|tun_[a-zA-Z0-9_-]+" | tail -n 30)
		if [ -n "$dmesg_match" ]; then
			sys_filtered="[内核 dmesg 关联信息]\n${dmesg_match}"
		fi
	fi

	# 4. 若依然无匹配结果，提供友好提示及系统最新日志概览，避免空白
	if [ -z "$sys_filtered" ]; then
		if [ -n "$sys_raw" ]; then
			local sys_tail
			sys_tail=$(echo "$sys_raw" | tail -n 20)
			sys_filtered="[提示: 系统日志中暂未检测到雷神(leigod/acc)特征记录，附最新系统日志供参考]\n${sys_tail}"
		else
			sys_filtered="(系统日志服务未运行或系统当前暂无日志记录)"
		fi
	fi

	local sys_log=""
	sys_log=$(echo "$sys_filtered" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' -e 's/$/\\n/g' | tr -d '\n')

	printf '{"lines":%d,"content":"%s","syslog":"%s"}' "$lines" "$log_content" "$sys_log"
}

do_install() {
	local result code

	# Ensure curl is available for official installer
	if ! command -v curl >/dev/null 2>&1; then
		if command -v opkg >/dev/null 2>&1; then
			opkg update >/dev/null 2>&1 || true
			opkg install curl >/dev/null 2>&1 || true
		elif command -v apk >/dev/null 2>&1; then
			apk add curl >/dev/null 2>&1 || true
		fi
	fi

	# Run official install command: cd /tmp && sh -c "$(curl -fsSL http://119.3.40.126/router_plugin_new/plugin_install.sh)"
	result=$(cd /tmp && sh -c "$(curl -fsSL http://119.3.40.126/router_plugin_new/plugin_install.sh 2>/dev/null || wget -qO- http://119.3.40.126/router_plugin_new/plugin_install.sh)" 2>&1)
	code=$?

	# Post-installation initialization
	if [ -x "${SBIN_DIR}/acc-gw.router.$(get_arch)" ]; then
		code=0
		_ensure_init_script >/dev/null 2>&1
		_apply_mode "$(_get_mode)"
		if [ -f /etc/init.d/acc ]; then
			chmod 0755 /etc/init.d/acc 2>/dev/null || true
			/etc/init.d/acc enable 2>/dev/null || true
			/etc/init.d/acc start >/dev/null 2>&1 || true
		fi
		_start_monitor
	fi

	result=$(echo "$result" | tail -n 25 | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/g' | tr -d '\n')
	[ -z "$result" ] && result="安装完成"
	printf '{"code":%d,"message":"%s"}\n' "$code" "$result"
}

do_uninstall() {
	local result code
	_stop_monitor
	[ -f /etc/init.d/acc ] && /etc/init.d/acc stop >/dev/null 2>&1 || true

	# Run official uninstall command: sh /usr/sbin/leigod/leigod_uninstall.sh
	if [ -f "${SBIN_DIR}/leigod_uninstall.sh" ]; then
		chmod 0755 "${SBIN_DIR}/leigod_uninstall.sh" 2>/dev/null || true
		result=$(sh "${SBIN_DIR}/leigod_uninstall.sh" 2>&1)
		code=$?
	else
		do_stop >/dev/null 2>&1
		_clean_rules
		rm -f /etc/init.d/acc
		rm -rf "${SBIN_DIR}"
		rm -f /etc/config/accelerator.ini "$FIREWALL_INI" "$VERSION_INI" \
		      /etc/config/acc_core_conf.json /etc/config/ipdatacloud_country.xdb
		code=0
		result="雷神加速器已成功卸载"
	fi

	# Fallback cleanup to ensure no lingering processes or rules
	_stop_monitor
	_kill_acc
	ps 2>/dev/null | grep acc | grep -v grep | awk '{print $1}' | xargs -r kill -9 2>/dev/null || true
	_clean_rules

	# Verify binary was removed
	if ! _is_installed; then
		code=0
	fi

	result=$(echo "$result" | tail -n 25 | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/g' | tr -d '\n')
	[ -z "$result" ] && result="卸载完成"
	printf '{"code":%d,"message":"%s"}\n' "$code" "$result"
}

do_get_config() {
	local enabled mode log_level
	enabled=$(uci get leigod-manager.base.enabled 2>/dev/null || echo "1")
	mode=$(_get_mode)
	log_level=$(uci get leigod-manager.base.log_level 2>/dev/null || echo "info")

	printf '{"enabled":%s,"mode":"%s","log_level":"%s"}' \
		"$(_json_bool "$enabled")" "$mode" "$log_level"
}

do_set_config() {
	local input enabled mode log_level
	input=$(cat)

	enabled=$(echo "$input" | jsonfilter -e '@.enabled' 2>/dev/null)
	mode=$(echo "$input" | jsonfilter -e '@.mode' 2>/dev/null)
	log_level=$(echo "$input" | jsonfilter -e '@.log_level' 2>/dev/null)

	[ -z "$mode" ] && mode=$(_get_mode)
	local cur_enabled
	cur_enabled=$(uci get leigod-manager.base.enabled 2>/dev/null || echo "1")
	[ -z "$enabled" ] && enabled="$cur_enabled"

	# If service is enabled, check mode dependencies before saving/restarting
	if [ "$enabled" != "0" ] && [ "$enabled" != "false" ]; then
		local missing_deps
		missing_deps=$(_check_missing_deps "$mode")
		if [ -n "$missing_deps" ]; then
			printf '{"code":1,"message":"%s 模式依赖未完成安装 (缺少: %s)，请先安装依赖"}\n' "$mode" "$missing_deps"
			return
		fi
	fi

	local init
	init=$(_ensure_init_script)

	[ -n "$mode" ] && _apply_mode "$mode"

	[ -n "$enabled" ] && {
		[ "$enabled" = "true" ] && enabled="1" || enabled="0"
		uci set leigod-manager.base.enabled="$enabled"
		if [ -n "$init" ]; then
			[ "$enabled" = "1" ] && "$init" enable 2>/dev/null || "$init" disable 2>/dev/null
		fi
	}

	[ -n "$log_level" ] && uci set leigod-manager.base.log_level="$log_level"

	uci commit leigod-manager 2>/dev/null || true

	# Apply changes: if enabled=0 stop service, else restart to apply new mode
	if [ "$enabled" = "0" ]; then
		do_stop >/dev/null 2>&1
		printf '{"code":0,"message":"config saved and service stopped"}\n'
	else
		if [ "$mode" = "tun" ]; then
			local prep_err
			prep_err=$(_prepare_tun_env)
			if [ $? -ne 0 ]; then
				printf '{"code":1,"message":"%s"}\n' "$prep_err"
				return
			fi
		fi
		do_restart >/dev/null 2>&1
		if _is_running; then
			printf '{"code":0,"message":"config saved and service restarted"}\n'
		else
			local last_err
			last_err=$(_get_last_error)
			[ -z "$last_err" ] && last_err="服务重启失败"
			printf '{"code":1,"message":"config saved but %s"}\n' "$last_err"
		fi
	fi
}

do_get_deps() {
	local installed_pkgs mgr
	installed_pkgs=$(_get_installed_pkgs_list)
	mgr=$(_detect_pkg_mgr)

	local tun_json="" tproxy_json="" p status ro
	for p in libpcap1 iptables kmod-tun kmod-ipt-nat kmod-ipt-ipset ipset curl; do
		if _is_installed_pkg "$p" "$installed_pkgs"; then status="true"; else status="false"; fi
		if [ "$status" = "true" ] && _is_rom_pkg "$p"; then ro="true"; else ro="false"; fi
		[ -n "$tun_json" ] && tun_json="${tun_json},"
		tun_json="${tun_json}{\"name\":\"$p\",\"installed\":$status,\"readonly\":$ro}"
	done

	for p in libpcap1 iptables iptables-mod-tproxy kmod-ipt-tproxy kmod-ipt-nat kmod-ipt-ipset ipset curl; do
		if _is_installed_pkg "$p" "$installed_pkgs"; then status="true"; else status="false"; fi
		if [ "$status" = "true" ] && _is_rom_pkg "$p"; then ro="true"; else ro="false"; fi
		[ -n "$tproxy_json" ] && tproxy_json="${tproxy_json},"
		tproxy_json="${tproxy_json}{\"name\":\"$p\",\"installed\":$status,\"readonly\":$ro}"
	done

	printf '{"pkg_mgr":"%s","tun":[%s],"tproxy":[%s]}\n' "$mgr" "$tun_json" "$tproxy_json"
}

do_manage_deps() {
	local input mode action pkg
	input=$(cat)
	mode=$(echo "$input" | jsonfilter -e '@.mode' 2>/dev/null)
	[ -z "$mode" ] && mode=$(echo "$input" | grep -o '"mode"[[:space:]]*:[[:space:]]*"[^"]*"' | cut -d'"' -f4)

	action=$(echo "$input" | jsonfilter -e '@.action' 2>/dev/null)
	[ -z "$action" ] && action=$(echo "$input" | grep -o '"action"[[:space:]]*:[[:space:]]*"[^"]*"' | cut -d'"' -f4)

	pkg=$(echo "$input" | jsonfilter -e '@.pkg' 2>/dev/null)
	[ -z "$pkg" ] && pkg=$(echo "$input" | grep -o '"pkg"[[:space:]]*:[[:space:]]*"[^"]*"' | cut -d'"' -f4)

	[ -z "$action" ] && action="install"

	# Map legacy libpcap name to libpcap1
	[ "$pkg" = "libpcap" ] && pkg="libpcap1"

	# If removing a single package that is built into ROM, reject with clear explanation
	if [ "$action" = "remove" ] && [ -n "$pkg" ]; then
		if _is_rom_pkg "$pkg"; then
			printf '{"code":1,"message":"组件 [%s] 为系统固件(ROM)内置组件，属于只读底层依赖，无法从路由器卸载。"}\n' "$pkg"
			return
		fi
	fi

	local target_pkgs=""
	if [ -n "$pkg" ]; then
		target_pkgs="$pkg"
	elif [ "$mode" = "tun" ]; then
		target_pkgs="libpcap1 iptables kmod-tun kmod-ipt-nat kmod-ipt-ipset ipset curl"
	elif [ "$mode" = "tproxy" ]; then
		target_pkgs="libpcap1 iptables iptables-mod-tproxy kmod-ipt-tproxy kmod-ipt-nat kmod-ipt-ipset ipset curl"
	fi

	if [ -z "$target_pkgs" ]; then
		printf '{"code":1,"message":"未指定依赖包或模式"}\n'
		return
	fi

	local log_file="/tmp/leigod_deps.log"
	> "$log_file"
	local code=0
	local mgr
	mgr=$(_detect_pkg_mgr)

	if [ "$mgr" = "opkg" ]; then
		_run_opkg() {
			local act="$1" p="$2"
			case "$p" in
				libpcap|libpcap1)
					if [ "$act" = "install" ]; then
						opkg install libpcap1 >> "$log_file" 2>&1 || opkg install libpcap >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						opkg install --force-reinstall libpcap1 >> "$log_file" 2>&1 || opkg install --force-reinstall libpcap >> "$log_file" 2>&1
					else
						opkg remove --force-depends libpcap1 libpcap >> "$log_file" 2>&1
					fi
					;;
				iptables)
					if [ "$act" = "install" ]; then
						opkg install iptables-nft >> "$log_file" 2>&1 || opkg install iptables >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						opkg install --force-reinstall iptables-nft >> "$log_file" 2>&1 || opkg install --force-reinstall iptables >> "$log_file" 2>&1
					else
						opkg remove --force-depends iptables-nft iptables xtables-nft >> "$log_file" 2>&1
					fi
					;;
				kmod-tun)
					if [ "$act" = "install" ]; then
						opkg install kmod-tun >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						opkg install --force-reinstall kmod-tun >> "$log_file" 2>&1
					else
						opkg remove --force-depends kmod-tun >> "$log_file" 2>&1
						rmmod tun >> "$log_file" 2>&1 || true
					fi
					;;
				kmod-ipt-nat)
					if [ "$act" = "install" ]; then
						opkg install kmod-ipt-nat >> "$log_file" 2>&1 || opkg install kmod-nft-nat >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						opkg install --force-reinstall kmod-ipt-nat >> "$log_file" 2>&1 || opkg install --force-reinstall kmod-nft-nat >> "$log_file" 2>&1
					else
						opkg remove --force-depends kmod-ipt-nat kmod-nft-nat >> "$log_file" 2>&1
					fi
					;;
				kmod-ipt-ipset)
					if [ "$act" = "install" ]; then
						opkg install kmod-ipt-ipset >> "$log_file" 2>&1 || opkg install kmod-nft-ipset >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						opkg install --force-reinstall kmod-ipt-ipset >> "$log_file" 2>&1 || opkg install --force-reinstall kmod-nft-ipset >> "$log_file" 2>&1
					else
						opkg remove --force-depends kmod-ipt-ipset kmod-nft-ipset >> "$log_file" 2>&1
					fi
					;;
				kmod-ipt-tproxy)
					if [ "$act" = "install" ]; then
						opkg install kmod-ipt-tproxy >> "$log_file" 2>&1 || opkg install kmod-nft-tproxy >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						opkg install --force-reinstall kmod-ipt-tproxy >> "$log_file" 2>&1 || opkg install --force-reinstall kmod-nft-tproxy >> "$log_file" 2>&1
					else
						opkg remove --force-depends kmod-ipt-tproxy kmod-nft-tproxy >> "$log_file" 2>&1
						rmmod xt_TPROXY >> "$log_file" 2>&1 || true
						rmmod nf_tproxy_core >> "$log_file" 2>&1 || true
						rmmod nf_tproxy >> "$log_file" 2>&1 || true
					fi
					;;
				iptables-mod-tproxy)
					if [ "$act" = "install" ]; then
						opkg install iptables-mod-tproxy >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						opkg install --force-reinstall iptables-mod-tproxy >> "$log_file" 2>&1
					else
						opkg remove --force-depends iptables-mod-tproxy >> "$log_file" 2>&1
					fi
					;;
				*)
					if [ "$act" = "install" ]; then
						opkg install "$p" >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						opkg install --force-reinstall "$p" >> "$log_file" 2>&1
					else
						opkg remove --force-depends "$p" >> "$log_file" 2>&1
					fi
					;;
			esac
		}

		for one_pkg in $target_pkgs; do
			# In batch remove, skip ROM packages silently
			if [ "$action" = "remove" ] && [ -z "$pkg" ] && _is_rom_pkg "$one_pkg"; then
				echo "[跳过] $one_pkg 是固件ROM内置组件，跳过卸载。" >> "$log_file"
				continue
			fi
			_run_opkg "$action" "$one_pkg"
			[ $? -ne 0 ] && code=1
		done
	elif [ "$mgr" = "apk" ]; then
		_run_apk() {
			local act="$1" p="$2"
			case "$p" in
				libpcap|libpcap1)
					if [ "$act" = "install" ]; then
						apk add libpcap >> "$log_file" 2>&1 || apk add libpcap1 >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						apk fix libpcap >> "$log_file" 2>&1 || apk fix libpcap1 >> "$log_file" 2>&1 || apk add --upgrade libpcap >> "$log_file" 2>&1
					else
						apk del libpcap libpcap1 >> "$log_file" 2>&1
					fi
					;;
				iptables)
					if [ "$act" = "install" ]; then
						apk add iptables-nft >> "$log_file" 2>&1 || apk add iptables >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						apk fix iptables-nft >> "$log_file" 2>&1 || apk fix iptables >> "$log_file" 2>&1 || apk add --upgrade iptables-nft >> "$log_file" 2>&1
					else
						apk del iptables-nft iptables xtables-nft >> "$log_file" 2>&1
					fi
					;;
				kmod-tun)
					if [ "$act" = "install" ]; then
						apk add kmod-tun >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						apk fix kmod-tun >> "$log_file" 2>&1 || apk add --upgrade kmod-tun >> "$log_file" 2>&1
					else
						apk del kmod-tun >> "$log_file" 2>&1
						rmmod tun >> "$log_file" 2>&1 || true
					fi
					;;
				kmod-ipt-nat)
					if [ "$act" = "install" ]; then
						apk add kmod-ipt-nat >> "$log_file" 2>&1 || apk add kmod-nft-nat >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						apk fix kmod-ipt-nat >> "$log_file" 2>&1 || apk fix kmod-nft-nat >> "$log_file" 2>&1 || apk add --upgrade kmod-ipt-nat >> "$log_file" 2>&1
					else
						apk del kmod-ipt-nat kmod-nft-nat >> "$log_file" 2>&1
					fi
					;;
				kmod-ipt-ipset)
					if [ "$act" = "install" ]; then
						apk add kmod-ipt-ipset >> "$log_file" 2>&1 || apk add kmod-nft-ipset >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						apk fix kmod-ipt-ipset >> "$log_file" 2>&1 || apk fix kmod-nft-ipset >> "$log_file" 2>&1 || apk add --upgrade kmod-ipt-ipset >> "$log_file" 2>&1
					else
						apk del kmod-ipt-ipset kmod-nft-ipset >> "$log_file" 2>&1
					fi
					;;
				kmod-ipt-tproxy)
					if [ "$act" = "install" ]; then
						apk add kmod-ipt-tproxy >> "$log_file" 2>&1 || apk add kmod-nft-tproxy >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						apk fix kmod-ipt-tproxy >> "$log_file" 2>&1 || apk fix kmod-nft-tproxy >> "$log_file" 2>&1 || apk add --upgrade kmod-ipt-tproxy >> "$log_file" 2>&1
					else
						apk del kmod-ipt-tproxy kmod-nft-tproxy >> "$log_file" 2>&1
						rmmod xt_TPROXY >> "$log_file" 2>&1 || true
						rmmod nf_tproxy_core >> "$log_file" 2>&1 || true
						rmmod nf_tproxy >> "$log_file" 2>&1 || true
					fi
					;;
				iptables-mod-tproxy)
					if [ "$act" = "install" ]; then
						apk add iptables-mod-tproxy >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						apk fix iptables-mod-tproxy >> "$log_file" 2>&1 || apk add --upgrade iptables-mod-tproxy >> "$log_file" 2>&1
					else
						apk del iptables-mod-tproxy >> "$log_file" 2>&1
					fi
					;;
				*)
					if [ "$act" = "install" ]; then
						apk add "$p" >> "$log_file" 2>&1
					elif [ "$act" = "reinstall" ]; then
						apk fix "$p" >> "$log_file" 2>&1 || apk add --upgrade "$p" >> "$log_file" 2>&1
					else
						apk del "$p" >> "$log_file" 2>&1
					fi
					;;
			esac
		}

		for one_pkg in $target_pkgs; do
			# In batch remove, skip ROM packages silently
			if [ "$action" = "remove" ] && [ -z "$pkg" ] && _is_rom_pkg "$one_pkg"; then
				echo "[跳过] $one_pkg 是固件ROM内置组件，跳过卸载。" >> "$log_file"
				continue
			fi
			_run_apk "$action" "$one_pkg"
			[ $? -ne 0 ] && code=1
		done
	else
		printf '{"code":1,"message":"系统未找到 opkg 或 apk 包管理器"}\n'
		return
	fi

	# Accurate post-removal status verification
	if [ "$action" = "remove" ]; then
		if [ -n "$pkg" ]; then
			if _is_installed_pkg "$pkg"; then
				code=1
				echo "[提示] 组件 [$pkg] 卸载后依然被检测为已安装，可能因固件只读内置或存在反向依赖。" >> "$log_file"
			else
				code=0
				echo "[成功] 组件 [$pkg] 已从系统中成功卸载。" >> "$log_file"
			fi
		fi
	fi

	if grep -qi "in rootfs (rom), cannot remove" "$log_file" 2>/dev/null; then
		echo "[说明] 带有只读(ROM)标识的组件固化在系统固件中，无需也不支持从 overlay 卸载。" >> "$log_file"
	fi

	local result
	result=$(tail -n 30 "$log_file" 2>/dev/null | awk '{gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "%s\\n", $0}')
	[ -z "$result" ] && result="操作完成 (Exit code: ${code})"
	printf '{"code":%d,"message":"%s"}\n' "$code" "$result"
}

# ---- dispatch ---------------------------------------------------------------

case "$1" in
	list)
		printf '{"get_status":{},"start":{},"stop":{},"restart":{},"set_mode":{"mode":"String"},"get_logs":{"lines":"Number"},"install":{},"uninstall":{},"get_config":{},"set_config":{"enabled":"Boolean","mode":"String","log_level":"String"},"get_deps":{},"manage_deps":{"mode":"String","action":"String","pkg":"String"}}\n'
		;;
	call)
		case "$2" in
			get_status)  do_get_status ;;
			start)       do_start ;;
			stop)        do_stop ;;
			restart)     do_restart ;;
			set_mode)    do_set_mode ;;
			get_logs)    do_get_logs ;;
			install)     do_install ;;
			uninstall)   do_uninstall ;;
			get_config)  do_get_config ;;
			set_config)  do_set_config ;;
			get_deps)    do_get_deps ;;
			manage_deps) do_manage_deps ;;
			*)
				printf '{"code":1,"message":"unknown method: %s"}\n' "$2"
				exit 1
				;;
		esac
		;;
	*)
		exit 1
		;;
esac
